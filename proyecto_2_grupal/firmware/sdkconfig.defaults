CONFIG_IDF_TARGET="esp32"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# Banco vigente (sensor LM393 de horquilla, disco de 20 ranuras y servo recalibrado, 25 nov 2026). Cableado: docs/02_conexiones.md.
# Servo en escala nominal 0..180 grados = 500..2500 us; tope mecanico 1000..2200 us (45..153 grados).
CONFIG_ASM_SENSOR_GPIO=27
CONFIG_ASM_SENSOR_FLANCO_BAJADA=y
CONFIG_ASM_PULSOS_POR_VUELTA=20
CONFIG_ASM_VENTANA_PULSOS=20
CONFIG_ASM_INTERVALO_MINIMO_PULSO_US=200
CONFIG_ASM_SERVO_GPIO=18
CONFIG_ASM_SERVO_FRECUENCIA_HZ=50
CONFIG_ASM_SERVO_MINIMO_DEG=45
CONFIG_ASM_SERVO_MAXIMO_DEG=153
CONFIG_ASM_SERVO_LIBERADO_DEG=90
CONFIG_ASM_SERVO_PULSO_MINIMO_US=1000
CONFIG_ASM_SERVO_PULSO_MAXIMO_US=2200
CONFIG_ASM_MOTOR_ENABLE_GPIO=25
CONFIG_ASM_MOTOR_ENTRADA1_GPIO=26
CONFIG_ASM_MOTOR_ENTRADA2_GPIO=33
CONFIG_ASM_MOTOR_FRECUENCIA_HZ=1000
CONFIG_ASM_MOTOR_MAXIMO_PORCENTAJE=60
CONFIG_ASM_MOTOR_MAXIMO_IMPULSO_MS=30000
