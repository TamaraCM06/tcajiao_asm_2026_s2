    end

    subgraph MCU["ESP32 · ejecución en secuencia"]
        direction LR
        FL["Flash<br/>4 MB"]
        DAC["① DAC + DMA<br/>APLL · 16 kHz"]
        GPIO["GPIO25"]
        BANCO["②③ Banco<br/>FIR → espectral"]
        UART["Consola UART<br/>115200 baud"]
        FL -->|"códigos u8<br/>bloques 256"| DAC
        DAC -->|"v(t)<br/>0–3.3 V"| GPIO
        FL -->|"pares<br/>float32"| BANCO
        BANCO -->|"métricas<br/>+ tiempos"| UART
        DAC -->|"reproducidas<br/>· paradas"| UART
    end

    PC -->|"códigos u8 + pares float32, incorporados al compilar"| MCU
