# Configuracion ASM2 usada en el ensayo escalon_02 (extracto de sdkconfig)
CONFIG_ASM_CONEXIONES_VERIFICADAS=y
CONFIG_ASM_SENSOR_GPIO=27
CONFIG_ASM_SENSOR_FLANCO_BAJADA=y
CONFIG_ASM_PULSOS_POR_VUELTA=10
CONFIG_ASM_INTERVALO_MINIMO_PULSO_US=500
CONFIG_ASM_SERVO_GPIO=18
CONFIG_ASM_SERVO_FRECUENCIA_HZ=50
CONFIG_ASM_SERVO_MINIMO_DEG=0
CONFIG_ASM_SERVO_MAXIMO_DEG=180
CONFIG_ASM_SERVO_LIBERADO_DEG=120
CONFIG_ASM_SERVO_PULSO_MINIMO_US=500
CONFIG_ASM_SERVO_PULSO_MAXIMO_US=2500
CONFIG_ASM_MOTOR_ENABLE_GPIO=25
CONFIG_ASM_MOTOR_ENTRADA1_GPIO=26
CONFIG_ASM_MOTOR_ENTRADA2_GPIO=33
CONFIG_ASM_MOTOR_FRECUENCIA_HZ=1000
CONFIG_ASM_MOTOR_MAXIMO_PORCENTAJE=60
CONFIG_ASM_MOTOR_MAXIMO_IMPULSO_MS=15000
