%% Diagrama de bloques del banco (03_flujo.md, 1). Linea gruesa: enlace serie USB.
flowchart TB
    subgraph pc["PC"]
        direction LR
        consola["<b>consola.py</b><br/>comandos cortos"]
        datos[("datos/<br/>CSV + JSON")]
        matlab["<b>visualizar_ensayo.m</b><br/>K, tau, h(t)"]
        consola --> datos --> matlab
    end

    subgraph esp["ESP32"]
        direction LR
        prot["<b>protocolo_serial</b><br/>UART0 115200"]
        app["<b>aplicacion</b><br/>comandos, ENSAYO,<br/>CAL y registro"]
        sens["<b>sensor_optico</b> +<br/><b>estimador_velocidad</b><br/>RPM por vuelta"]
        servo["<b>servo_freno</b><br/>PWM 50 Hz"]
        mot["<b>motor</b><br/>PWM 1 kHz"]
        prot <--> app
        sens --> app
        app --> servo
        app --> mot
    end

    subgraph banco["Banco"]
        direction LR
        mg["MG90S<br/>+ goma"]
        puente["L298N"]
        dc["Motor CD"]
        disco(("Disco de<br/>20 ranuras"))
        lm["LM393<br/>horquilla"]
    end

    consola <==>|"USB"| prot
    servo -->|"GPIO18"| mg
    mot -->|"GPIO25, 26, 33"| puente --> dc --> disco
    mg -->|"friccion"| disco
    disco -->|"ranuras"| lm
    lm -->|"DO, GPIO27"| sens

    classDef bloque fill:#0d1117,stroke:#e6edf3,stroke-width:1.6px,color:#e6edf3
    classDef externo fill:#0d1117,stroke:#8b949e,stroke-width:1.2px,color:#e6edf3
    class consola,matlab,prot,app,sens,servo,mot bloque
    class datos,mg,puente,dc,disco,lm externo
    style pc fill:#0d1117,stroke:#6e7681,stroke-width:1px,color:#8b949e
    style esp fill:#0d1117,stroke:#6e7681,stroke-width:1px,color:#8b949e
    style banco fill:#0d1117,stroke:#6e7681,stroke-width:1px,color:#8b949e
