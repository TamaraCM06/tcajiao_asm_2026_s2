%% Una sesion de consola con un ensayo (03_flujo.md, 4).
sequenceDiagram
    actor O as Operador
    participant C as consola.py
    participant E as ESP32
    C->>E: STATUS, CONFIG 20 10000 100, CONFIG
    E-->>C: estado, ok, configuracion
    C->>E: FRENO 90 (liberar)
    O->>C: ensayo
    C->>E: ENSAYO 60 153 300
    loop cada 0,3 s mientras acelera
        C->>E: STATUS
        E-->>C: velocidad_rpm
    end
    E-->>C: velocidad_maxima, inicio, configuracion, cabecera
    loop cada 20 ms
        E-->>C: tiempo_ms, freno_deg, velocidad_rpm
    end
    E-->>C: evento freno en t = 300 ms
    E-->>C: fin con producidas, enviadas y completo
    C->>O: datos/ensayo_NN.csv y resumen
